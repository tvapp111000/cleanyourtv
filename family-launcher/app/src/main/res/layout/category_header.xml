<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false">

            <LinearLayout android:id="@+id/leftBlock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/topButtons" android:layout_marginEnd="16dp" android:orientation="vertical">

                
                <TextView android:id="@+id/greeting" android:gravity="left" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:layout_marginStart="4dp" android:textColor="#8CFFFFFF" android:textSize="12sp" android:fontFamily="@string/font_medium" android:letterSpacing="0.22" android:textAllCaps="true" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="true">

                    <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textColor="#FFFFFFFF" android:textSize="52sp" android:fontFamily="@string/font_light" android:letterSpacing="-0.04" android:includeFontPadding="false" />

                    <TextClock android:id="@+id/ampm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_gravity="bottom" android:layout_marginBottom="8dp" android:format12Hour="a" android:format24Hour="" android:textColor="#B3FFFFFF" android:textSize="15sp" android:fontFamily="@string/font_medium" android:letterSpacing="0.08" android:textAllCaps="true" />

                    <View android:id="@+id/clockDivider" android:layout_width="1dp" android:layout_height="26dp" android:layout_gravity="bottom" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="8dp" android:background="#33FFFFFF" />

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginBottom="9dp" android:orientation="vertical">

                        
                        <TextView android:id="@+id/shamsiDate" android:gravity="left" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#E6FFFFFF" android:textSize="17sp" android:fontFamily="@string/font_regular" android:letterSpacing="0.02" android:includeFontPadding="false" android:visibility="gone" />

                        <TextClock android:id="@+id/date" android:gravity="left" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="@bool/date_single_line" android:maxLines="2" android:lineSpacingExtra="6dp" android:ellipsize="end" android:format12Hour="@string/date_format_home" android:format24Hour="@string/date_format_home" android:textColor="#A6FFFFFF" android:textSize="14sp" android:fontFamily="@string/font_regular" android:letterSpacing="0.14" android:textAllCaps="true" />

                        
                        <TextView android:id="@+id/lunarDate" android:gravity="left" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:singleLine="true" android:ellipsize="end" android:textColor="#80FFFFFF" android:textSize="14sp" android:fontFamily="@string/font_regular" android:letterSpacing="0.14" android:textAllCaps="true" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            
            <TextView android:id="@+id/stats" android:layout_width="wrap_content" android:layout_below="@id/leftBlock" android:layout_alignStart="@id/leftBlock" android:gravity="left" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true" android:ellipsize="end" android:textColor="#D9FFFFFF" android:textSize="14sp" android:fontFamily="@string/font_medium" android:letterSpacing="0.04" android:focusable="false" android:visibility="gone" />

            <LinearLayout android:id="@+id/topButtons" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_alignBottom="@id/leftBlock" android:layout_marginBottom="6dp" android:clipChildren="false" android:clipToPadding="false" android:orientation="horizontal">

                <TextView android:id="@+id/btnInputs" style="@style/TopButton" android:text="@string/inputs" android:drawableStart="@drawable/ic_input" android:nextFocusDown="@+id/grid" />

                <TextView android:id="@+id/btnWifi" style="@style/TopButton" android:maxWidth="180dp" android:singleLine="true" android:ellipsize="end" android:text="@string/wifi" android:drawableStart="@drawable/ic_wifi" android:nextFocusDown="@+id/grid" />

                <TextView android:id="@+id/btnVpn" style="@style/TopButton" android:visibility="gone" android:singleLine="true" android:text="@string/vpn" android:nextFocusDown="@+id/grid" />

                <TextView android:id="@+id/btnReorder" style="@style/TopButtonIcon" android:contentDescription="@string/reorder" android:drawableStart="@drawable/ic_swap_vert" android:nextFocusDown="@+id/grid" />

                <TextView android:id="@+id/btnLibraryTop" style="@style/TopButtonIcon" android:visibility="gone" android:contentDescription="@string/app_library" android:drawableStart="@drawable/ic_apps_pill" android:nextFocusDown="@+id/grid" />

                <TextView android:id="@+id/btnSettings" style="@style/TopButton" android:text="@string/settings" android:drawableStart="@drawable/ic_settings" android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        
        